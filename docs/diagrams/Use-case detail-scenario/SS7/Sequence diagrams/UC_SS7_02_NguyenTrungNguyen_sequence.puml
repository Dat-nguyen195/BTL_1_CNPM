@startuml UC_SS7_02_NguyenTrungNguyen_sequence
!theme plain
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "Detailed UML Sequence Diagram: SS7 - Cảnh báo và điều hướng Hub 1-chạm"

actor "Sinh viên ĐHQG-HCM" as Student
box "Boundary / UI Layer" #LightCyan
participant "student_booking.py\n(UI)" as UI
end box
box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box
box "Routing Service" #LightGreen
participant "Spatial Routing\n(Matrix)" as Routing
end box
box "Related Subsystems" #White
participant "Đặt xe dùng chung\n(SS1)" as SS1
participant "Hub IoT" as IoT
end box

autonumber 1.1
group 1. Phát hiện Hub đích không khả dụng
    AppState -> UI: Phát hiện Hub đích OFFLINE / ERROR\nhoặc available_slots == 0
    activate UI
    UI -> AppState: Đọc booking và danh sách Hub
    activate AppState
    AppState --> UI: Trả về Hub đích, booking và hubs
    deactivate AppState

    UI -> Routing: Tìm Hub thay thế gần nhất
    activate Routing
    Routing -> IoT: Đọc trạng thái, slot và tọa độ các Hub
    activate IoT
    IoT --> Routing: Dữ liệu Hub trong mạng lưới
    deactivate IoT
    Routing -> Routing: Lọc available_slots > 0,\ntính khoảng cách và lấy Top 2

    alt Không có Hub nào còn khả dụng
        Routing --> UI: Không tìm thấy Hub thay thế
        deactivate Routing
        UI -> AppState: Đóng băng cước phí chờ phát sinh
        activate AppState
        AppState --> UI: Thời gian chờ được miễn phí
        deactivate AppState
        UI --> Student: Cảnh báo toàn mạng quá tải/sự cố;\nthông báo tạm giữ xe an toàn
    else Có Hub thay thế
        Routing --> UI: Danh sách tối đa 2 Hub gần nhất
        deactivate Routing
        UI --> Student: Hiển thị cảnh báo, khoảng cách,\nslot trống và lựa chọn điều hướng

        alt Sinh viên xác nhận Hub gợi ý thứ nhất
            Student -> UI: Chọn "Chuyển đặt chỗ 1 chạm"
            UI -> SS1: Yêu cầu chuyển điểm đến sang Hub 1
            activate SS1
            SS1 -> IoT: Kiểm tra slot Hub 1 và giữ 1 slot
            activate IoT
            alt Hub 1 vẫn còn slot
                IoT --> SS1: Giữ slot thành công
            else Slot cuối vừa được giữ bởi người khác
                IoT --> SS1: Hub 1 đã hết slot
                SS1 -> IoT: Kiểm tra và giữ slot tại Hub 2
                IoT --> SS1: Kết quả giữ slot Hub 2
            end
            deactivate IoT
            SS1 --> UI: Xác nhận Hub mới và slot RESERVED
            deactivate SS1
        else Sinh viên tự chọn Hub thứ ba
            Student -> UI: Mở danh sách Hub và chọn Hub khác
            UI -> SS1: Yêu cầu chuyển điểm đến sang Hub đã chọn
            activate SS1
            SS1 -> IoT: Kiểm tra và giữ 1 slot tại Hub đã chọn
            activate IoT
            IoT --> SS1: Kết quả kiểm tra và giữ slot
            deactivate IoT
            SS1 --> UI: Xác nhận điểm đến mới
            deactivate SS1
        end

        UI -> AppState: Cập nhật active_booking.destination_hub
        activate AppState
        AppState -> AppState: Bảo toàn tiền cọc;\ncộng 15 phút miễn phí (tổng 45 phút)
        AppState --> UI: Cập nhật booking hoàn tất
        deactivate AppState
        UI --> Student: Xác nhận chuyển hướng và cập nhật lộ trình
    end
    deactivate UI
end

autonumber 2.1
group 2. Chặn đặt chỗ tại Hub lỗi
    opt Sinh viên đang tạo đặt chỗ mới
        Student -> UI: Chọn Hub đích gặp sự cố/hết chỗ
        UI -> AppState: Kiểm tra trạng thái và slot Hub
        activate AppState
        AppState --> UI: Hub không khả dụng
        deactivate AppState
        UI -> Routing: Tìm tối đa 2 Hub lân cận còn slot
        activate Routing
        Routing --> UI: Danh sách Hub thay thế
        deactivate Routing
        UI --> Student: Chặn đặt chỗ tại Hub lỗi;\nhiển thị Hub thay thế
    end
end

@enduml
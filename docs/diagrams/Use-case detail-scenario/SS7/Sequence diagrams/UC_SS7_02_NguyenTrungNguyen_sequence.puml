@startuml UC_SS7_02_NguyenTrungNguyen_sequence
!include ../../../common.puml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "Detailed UML Sequence Diagram: SS7 - Cảnh báo và điều hướng Hub 1-chạm"

actor "Sinh viên ĐHQG-HCM" as Student

box "Boundary / UI Layer" #LightCyan
participant "student_booking.py\n(UI)" as UI
end box

box "External Authentication" #White
participant "Cổng VNU-SSO\n(SSO)" as SSO
end box

box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box

box "Routing Service" #LightGreen
participant "Spatial Routing\n(core/routing.py)" as Routing
end box

box "External Payment" #White
participant "Sổ cái / Ví điện tử\n(E-Wallet)" as EWallet
end box

box "Related Subsystems" #LightGray
participant "Cảm biến & Cổng sạc\n(IoT Hardware)" as IoT
end box

autonumber 1.1
group 1. Phát hiện Hub đích không khả dụng & Đề xuất điều hướng
    Student -> UI: Di chuyển đến Hub đích để trả xe
    activate UI
    
    UI -> AppState: Đọc thông tin chuyến đi active_booking\nvà kiểm tra available_slots của Hub đích
    activate AppState
    AppState --> UI: Hub đích available_slots == 0 hoặc OFFLINE
    deactivate AppState

    UI -> Routing: find_alternative_hubs(hubs, dest_hub_id, need_slots=True, limit=2)
    activate Routing
    Routing -> Routing: Lọc Hubs đang mở, tính khoảng cách Haversine\nvà chọn Top 2 Hub gần nhất còn chỗ
    Routing --> UI: Trả về danh sách 2 Hub thay thế
    deactivate Routing

    alt Không có Hub nào trong khu vực còn chỗ trống
        UI -> AppState: Đóng băng cước phí chờ phát sinh
        activate AppState
        AppState --> UI: Đã kích hoạt thời gian chờ miễn phí
        deactivate AppState
        UI --> Student: Cảnh báo sự cố toàn mạng; hướng dẫn đỗ xe tạm thời an toàn
    else Có Hub thay thế khả dụng
        UI --> Student: Hiển thị cảnh báo Hub đầy + Nút bấm "Chuyển tới đây (+15p)"
    end
    deactivate UI
end

autonumber 2.1
group 2. Sinh viên xác nhận điều hướng 1-chạm (1-Tap Reroute)
    Student -> UI: Nhấn nút "Chuyển tới đây (+15p)" cho Hub gợi ý
    activate UI

    UI -> AppState: apply_rerouting_to_booking(booking_id, new_hub_id)
    activate AppState
    AppState -> AppState: Kiểm tra Hub mới còn chỗ đỗ trống
    
    alt Hub mới vẫn còn chỗ đỗ
        AppState -> AppState: Giải phóng giữ chỗ Hub cũ (destination_holds - 1)
        AppState -> AppState: Giữ 1 chỗ tại Hub mới (available_slots - 1, destination_holds + 1)
        AppState -> AppState: Bảo toàn 100% tiền cọc;\ncộng 15 phút thuê xe miễn phí (extra_free_minutes = 15)
        AppState --> UI: Điều hướng thành công
        UI --> Student: Thông báo: "Đã chuyển điểm đến sang Hub mới và tặng thêm 15 phút thuê miễn phí!"
    else Hub mới vừa bị lấp đầy bởi người khác
        AppState --> UI: Hub gợi ý vừa hết chỗ
        UI -> Routing: Quét lại trạm thay thế thứ hai
        activate Routing
        Routing --> UI: Hub dự phòng kế tiếp
        deactivate Routing
        UI --> Student: Cảnh báo trạm vừa đầy; đề xuất trạm dự phòng tiếp theo
    end
    deactivate AppState
    deactivate UI
end

@enduml
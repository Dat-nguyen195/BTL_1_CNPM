@startuml UC_SS1_03_NguyenThanhDat_activity
!theme plain
skinparam activityMessageAlign center

title Activity Diagram - UC_SS1_03: Hủy đặt xe & Hoàn 100% tiền cọc

|Sinh viên ĐHQG-HCM|
start
:Bấm "Hủy giữ chỗ"\ntrên ứng dụng;

|UI Layer (student_booking.py)|
:Kiểm tra thời gian đếm ngược;

if (Thời gian còn trong 15 phút?) then (Quá 15p - No-show)
  |Tài khoản & Ví điện tử|
  :Khấu trừ phạt No-show 10,000 VNĐ,\nhoàn 40,000 VNĐ về wallet_balance;
  
  |Control & State (st.session_state)|
  :Chuyển xe từ RESERVED\nvề AVAILABLE;
  
  |UI Layer (student_booking.py)|
  :Thông báo tự hủy do quá hạn 15p\n(Phạt 10.000đ, hoàn 40.000đ);
else (Còn trong 15p - Hủy chủ động)
  |Tài khoản & Ví điện tử|
  :Giải phóng 100% cọc 50,000 VNĐ\ntừ locked_balance trở về\nwallet_balance khả dụng;
  
  |Control & State (st.session_state)|
  :Chuyển xe từ RESERVED\nvề AVAILABLE;
  
  |UI Layer (student_booking.py)|
  :Hiển thị thông báo hủy thành công\nkèm hoàn 100% cọc (50.000đ);
endif
stop


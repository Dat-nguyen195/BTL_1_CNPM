@startuml UC_SS1_02_NguyenThanhDat_sequence
!theme plain
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "Detailed UML Sequence Diagram: SS1 - Trả xe 1-chiều & Quyết toán ví điện tử"

actor "Sinh viên ĐHQG-HCM" as Student
box "Boundary / UI Layer" #LightCyan
participant "student_booking.py\n(UI)" as UI
end box
box "External Authentication" #White
participant "Cổng VNU-SSO\n(SSO)" as SSO
end box
box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box
box "External Payment" #White
participant "Ví điện tử\n(E-Wallet)" as EWallet
end box
box "Hardware / IoT" #LightGray
participant "Khóa IoT\n(SmartLock_IoT)" as SmartLock
end box

autonumber 1.1
group 1. Kiểm tra Hub đích & Trả xe
    Student -> UI: Di chuyển đến Hub đích & bấm "Trả xe"
    activate UI
    
    alt Hub đích lấp đầy 100% hoặc OFFLINE
        UI -> UI: Trigger gọi ngầm UC_SS7_02:\nĐề xuất điều hướng 1-chạm\nsang Hub lân cận
        note right of UI
            - Bảo toàn cọc
            - Tặng 15p di chuyển miễn phí
        end note
        UI --> Student: Hiển thị gợi ý Hub lân cận
    else Hub đích khả dụng (Main Flow)
        UI -> SmartLock: Gửi tín hiệu khóa xe
        activate SmartLock
        SmartLock --> UI: Xác nhận đã khóa chốt an toàn\n& Báo cáo số km / điện tiêu thụ
        deactivate SmartLock
    end
end

autonumber 2.1
group 2. Tính cước & Bồi hoàn cọc
    UI -> UI: Tính toán thời gian di chuyển\n(Miễn phí 30p đầu theo chính sách SV)
    
    UI -> EWallet: Gửi yêu cầu quyết toán chuyến đi
    activate EWallet
    EWallet --> UI: Giải phóng 50,000 VNĐ từ locked_balance,\ntrừ cước phát sinh từ wallet_balance
    deactivate EWallet
    
    UI --> Student: Xuất hóa đơn điện tử (e-invoice)
end

autonumber 3.1
group 3. Cập nhật Trạng thái
    UI -> AppState: Cập nhật xe = AVAILABLE\n(Hoặc CHARGING nếu SoC < 20%)
    activate AppState
    AppState --> UI: Cập nhật hoàn tất
    deactivate AppState
    deactivate UI
end

@enduml

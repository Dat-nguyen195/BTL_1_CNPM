@startuml UC_SS4_01_sequence
!include ../../../common.puml
title UC_SS4_01 - Điều phối phương tiện giữa các Hub
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

actor "Nhân viên Vận hành\n(Operator)" as OP

box "Boundary / UI Layer" #LightCyan
participant "dispatch_incident.py\n(UI)" as UI
end box

box "External Authentication" #White
participant "Cổng VNU-SSO\n(SSO)" as SSO
end box

box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box

box "External Payment" #White
participant "Sổ cái / Ví điện tử\n(E-Wallet)" as EWallet
end box

box "Hardware / IoT" #LightGray
participant "Khóa IoT / Trạm Hub\n(Hub Hardware)" as IoT
end box

autonumber 1.1
group 1. Chọn Hub & Lọc xe khả dụng
    OP -> UI: Mở tab "Tạo lệnh điều phối"
    activate UI
    
    OP -> UI: Chọn Hub nguồn và Hub đích
    UI -> AppState: Lấy danh sách xe dùng chung có trạng thái AVAILABLE
    activate AppState
    AppState --> UI: Danh sách xe khả dụng tại Hub nguồn
    deactivate AppState

    alt Hub nguồn không có xe AVAILABLE
        UI --> OP: Thông báo: "Không có xe khả dụng (AVAILABLE) tại Hub nguồn"
    else Hub nguồn có xe khả dụng
        UI --> OP: Hiển thị danh sách xe (Mã xe, mức pin SoC, loại xe)
    end
    deactivate UI
end

autonumber 2.1
group 2. Kiểm tra sức chứa & Khởi tạo điều chuyển
    OP -> UI: Chọn danh sách xe cần chuyển, nhập lý do điều phối\n& nhấn "Khởi tạo lệnh điều phối"
    activate UI

    alt Hub nguồn trùng Hub đích
        UI --> OP: Báo lỗi: "Hub nguồn và Hub đích phải khác nhau!"
    else Chưa chọn xe nào
        UI --> OP: Báo lỗi: "Vui lòng chọn ít nhất 1 xe để điều phối."
    else Sức chứa Hub đích không đủ (len(vehicles) > dest.available_slots)
        UI -> AppState: Kiểm tra số chỗ đỗ khả dụng tại Hub đích
        activate AppState
        AppState --> UI: available_slots < số lượng xe cần chuyển
        deactivate AppState
        UI --> OP: Báo lỗi: "Hub đích không đủ chỗ đỗ tiếp nhận (Từ chối điều phối)!"
    else Hợp lệ & Đủ sức chứa tiếp nhận
        UI -> AppState: Cập nhật điều phối (Nguồn: available_slots + N;\nĐích: available_slots - N, destination_holds + N)
        activate AppState
        AppState -> AppState: Đổi trạng thái xe thành DISPATCHED
        AppState -> AppState: Ghi nhật ký st.session_state["dispatch_log"]
        AppState --> UI: Xác nhận đã kích hoạt chuyến trung chuyển
        deactivate AppState
        UI --> OP: Thông báo: "Đã tạo lệnh điều phối N xe sang trạng thái DISPATCHED"
    end
    deactivate UI
end

autonumber 3.1
group 3. Tiếp nhận xe tại Hub đích (Hoàn tất điều chuyển)
    OP -> UI: Mở tab "Tiếp nhận xe trung chuyển" & nhấn "Xác nhận tiếp nhận"
    activate UI
    UI -> AppState: Chuyển xe từ DISPATCHED về AVAILABLE tại Hub đích
    activate AppState
    AppState -> AppState: destination_holds - N, gắn xe vào current_vehicles của Hub đích
    AppState --> UI: Tiếp nhận hoàn tất
    deactivate AppState
    UI --> OP: Thông báo: "Đã tiếp nhận xe an toàn tại Hub đích. Xe đã sẵn sàng (AVAILABLE)!"
    deactivate UI
end

@enduml

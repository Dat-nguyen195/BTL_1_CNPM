@startuml UC_SS4_01_sequence
title UC_SS4_01 - Điều phối phương tiện giữa các Hub (Sơ đồ tuần tự)
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber

actor "Nhân viên vận hành" as OP
participant "Giao diện điều phối SS4" as UI
participant "Bộ điều khiển điều phối" as CTRL
database "session_state[hubs]" as HUBS
database "session_state[dispatch_log]" as LOG
participant "Dashboard SS3" as DASH

OP -> UI : mở tab "Điều chuyển phương tiện"
OP -> UI : chọn Hub nguồn và Hub đích
UI -> CTRL : lấy danh sách xe khả dụng (Hub nguồn)
CTRL -> HUBS : đọc các xe có trạng thái PARKED
HUBS --> CTRL : danh sách xe (mã xe, loại xe, SoC)
CTRL --> UI : danh sách xe

alt Hub nguồn không có xe PARKED
  UI --> OP : "Không có xe khả dụng tại Hub nguồn"
  UI -> UI : vô hiệu hóa nút gửi lệnh
else Hub nguồn có xe khả dụng
  UI --> OP : hiển thị xe kèm mức pin và loại xe
  OP -> UI : tích chọn xe, nhập lý do điều phối
  OP -> UI : nhấn "Thực hiện điều phối"
  UI -> CTRL : điều phối (Hub nguồn, Hub đích, danh sách mã xe, lý do)

  alt Hub nguồn trùng Hub đích
    CTRL --> UI : lỗi
    UI --> OP : "Hub nguồn và Hub đích phải khác nhau!"
  else Chưa chọn xe nào
    CTRL --> UI : lỗi
    UI --> OP : "Vui lòng chọn ít nhất 1 xe để điều phối."
  else Lệnh hợp lệ
    CTRL -> HUBS : chuyển xe từ Hub nguồn sang Hub đích
    CTRL -> HUBS : đặt trạng thái xe = DISPATCHED
    CTRL -> HUBS : cập nhật số chỗ trống (nguồn +N, đích -N)
    HUBS --> CTRL : đã cập nhật
    CTRL -> LOG : ghi bản ghi (thời gian, nguồn, đích, mã xe, lý do)
    LOG --> CTRL : đã lưu
    CTRL --> UI : thành công
    UI --> OP : "Đã điều phối N xe từ Hub A → Hub B"
    CTRL ->> DASH : làm mới dữ liệu Hub
    note right: Thời gian xử lý dưới 1,0 giây
  end
end

opt Xem lịch sử điều phối
  OP -> UI : mở tab "Nhật ký"
  UI -> LOG : đọc toàn bộ bản ghi
  LOG --> UI : các bản ghi điều phối
  UI --> OP : bảng nhật ký điều phối
end
@enduml

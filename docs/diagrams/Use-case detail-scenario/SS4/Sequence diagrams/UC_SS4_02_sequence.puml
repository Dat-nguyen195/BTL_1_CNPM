@startuml UC_SS4_02_sequence
!include ../../../common.puml
title UC_SS4_02 - Báo cáo & Xử lý sự cố phương tiện và hạ tầng trạm
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

actor "Nhân viên Vận hành / KTV" as OP

box "Boundary / UI Layer" #LightCyan
participant "dispatch_incident.py\n(UI)" as UI
end box

box "External Authentication" #White
participant "Cổng VNU-SSO\n(SSO)" as SSO
end box

box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box

box "External Payment" #White
participant "Sổ cái / Ví điện tử\n(E-Wallet)" as EWallet
end box

box "Hardware / IoT" #LightGray
participant "Cảm biến trạm Hub\n(IoT Telemetry)" as IoT
end box

autonumber 1.1
group 1. Ghi nhận & Cách ly sự cố
    OP -> UI: Mở tab "Báo cáo sự cố trạm"
    activate UI
    
    OP -> UI: Chọn Hub, đối tượng sự cố (Xe / Cổng sạc), mức độ và nhập mô tả
    OP -> UI: Nhấn nút "Ghi nhận sự cố & Cách ly"

    UI -> AppState: Tìm đối tượng và chuyển trạng thái sang INCIDENT / OFFLINE
    activate AppState
    AppState -> AppState: Cách ly tài nguyên khỏi danh sách khả dụng (SS1 / SS2)
    AppState -> AppState: Lưu thông tin vào st.session_state["incident_log"]
    AppState --> UI: Xác nhận sự cố đã được ghi nhận và cách ly
    deactivate AppState

    UI --> OP: Thông báo: "Đã cách ly thành công tài nguyên gặp sự cố"
    deactivate UI
end

autonumber 2.1
group 2. Tiếp nhận xử lý & Phục hồi tài nguyên
    OP -> UI: Mở tab "Xử lý sự cố đang diễn ra"
    activate UI
    
    OP -> UI: Chọn sự cố cần xử lý & nhấn "Xác nhận tiếp nhận"
    UI -> AppState: Cập nhật trạng thái sự cố = ACKNOWLEDGED
    activate AppState
    AppState --> UI: Đã cập nhật
    deactivate AppState
    UI --> OP: Hiển thị: "Kỹ thuật viên đang tiến hành sửa chữa"

    OP -> UI: Kỹ thuật hoàn tất sửa chữa & nhấn "Hoàn tất sửa chữa"
    UI -> AppState: Đổi trạng thái sự cố = RESOLVED\nvà khôi phục xe/cổng sạc về AVAILABLE
    activate AppState
    AppState -> AppState: Cập nhật trạng thái tài nguyên sẵn sàng hoạt động
    AppState --> UI: Khôi phục hoàn tất
    deactivate AppState
    UI --> OP: Thông báo: "Tài nguyên đã phục hồi an toàn về trạng thái AVAILABLE!"
    deactivate UI
end

@enduml

@startuml UC_SS5_01_DuongDangKhoa_sequence
!include ../../../common.puml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "Detailed UML Sequence Diagram: SS5 - Lập lịch ưu tiên sạc tự động"

actor "Chuyên viên vận hành sạc\n(Operator)" as Operator

box "Boundary / UI Layer" #LightCyan
participant "smart_charging.py\n(UI)" as UI
end box

box "External Authentication" #White
participant "Cổng VNU-SSO\n(SSO)" as SSO
end box

box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box

box "Charging Scheduler" #LightYellow
participant "Bộ lập lịch sạc\n(SmartChargingScheduler)" as Scheduler
end box

box "External Payment" #White
participant "Sổ cái / Ví điện tử\n(E-Wallet)" as EWallet
end box

box "Hardware / IoT" #LightGray
participant "Cảm biến & Cổng sạc\n(ChargingIoT)" as IoT
end box

autonumber 1.1
group 1. Lấy dữ liệu và trạng thái sạc
    Operator -> UI: Mở chức năng lập lịch sạc
    activate UI

    UI -> AppState: Lấy danh sách xe WAITING
    activate AppState
    AppState --> UI: Trả về danh sách xe chờ sạc
    deactivate AppState

    UI -> IoT: Lấy SoC và trạng thái cổng sạc
    activate IoT
    IoT --> UI: Trả về dữ liệu IoT
    deactivate IoT

    UI -> AppState: Lấy cấu hình giờ điện\nvà giới hạn công suất (150 kW)
    activate AppState
    AppState --> UI: Trả về cấu hình
    deactivate AppState
end

autonumber 2.1
group 2. Tính điểm ưu tiên và sắp xếp
    UI -> Scheduler: Gửi danh sách xe và dữ liệu sạc
    activate Scheduler

    alt Dữ liệu không hợp lệ
        Scheduler --> UI: Báo lỗi dữ liệu đầu vào
        UI --> Operator: Hiển thị thông báo lỗi
    else Dữ liệu hợp lệ
        Scheduler -> Scheduler: Tính Priority Score theo công thức:\n0.5*(100-SoC) + 100*I(SoC<20) + 60*I(has_booking) + 30*I(SoC<50)
        Scheduler -> Scheduler: Sắp xếp hàng chờ giảm dần\ntheo Priority Score (Tie: FIFO, vehicle_id)
        Scheduler --> UI: Trả về thứ tự ưu tiên
    end
    deactivate Scheduler
end

autonumber 3.1
group 3. Phân bổ công suất và lập lịch (Power Cap 150 kW)
    UI -> Scheduler: Yêu cầu phân bổ cổng sạc (allocate_ports)
    activate Scheduler

    Scheduler -> Scheduler: Kiểm tra Hub Power Capping (sum(kW) <= 150 kW)

    alt Vượt giới hạn công suất trạm hoặc hết cổng khả dụng
        Scheduler --> UI: Không thể phân bổ thêm cổng sạc (Trả xe về trạng thái WAITING)
        UI --> Operator: Thông báo: Giới hạn công suất 150 kW hoặc hết cổng khả dụng
    else Công suất và cổng sạc hợp lệ
        Scheduler -> Scheduler: Tạo phiên sạc ChargingSession\nvà phân bổ công suất
        Scheduler --> UI: Trả về danh sách phiên sạc hợp lệ
        
        UI -> AppState: Cập nhật xe = CHARGING và cổng sạc = OCCUPIED
        activate AppState
        AppState --> UI: Xác nhận cập nhật
        deactivate AppState

        UI --> Operator: Hiển thị thứ tự ưu tiên và phiên sạc đã phân bổ
    end
    deactivate Scheduler
    deactivate UI
end

@enduml

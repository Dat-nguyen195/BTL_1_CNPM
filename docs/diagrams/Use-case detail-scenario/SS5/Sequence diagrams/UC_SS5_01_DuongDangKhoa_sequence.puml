
@startuml UC_SS5_01_DuongDangKhoa_sequence
!theme plain
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam BoxPadding 10

title "Detailed UML Sequence Diagram: SS5 - Lập lịch ưu tiên sạc tự động"

actor "Chuyên viên vận hành sạc\n(Operator)" as Operator

box "Boundary / UI Layer" #LightCyan
participant "smart_charging.py\n(UI)" as UI
end box

box "Control & State" #LightYellow
participant "st.session_state\n(AppState)" as AppState
end box

box "Hardware / IoT" #LightGray
participant "Cảm biến IoT\n(ChargingIoT)" as IoT
end box

box "Charging Scheduler" #LightYellow
participant "Bộ lập lịch sạc\n(SmartChargingScheduler)" as Scheduler
end box

autonumber 1.1
group 1. Lấy dữ liệu và trạng thái sạc
    Operator -> UI: Mở chức năng lập lịch sạc
    activate UI

    UI -> AppState: Lấy danh sách xe WAITING
    activate AppState
    AppState --> UI: Trả về danh sách xe chờ sạc
    deactivate AppState

    UI -> IoT: Lấy SoC và trạng thái cổng sạc
    activate IoT
    IoT --> UI: Trả về dữ liệu IoT
    deactivate IoT

    UI -> AppState: Lấy cấu hình giờ điện\nvà giới hạn công suất
    activate AppState
    AppState --> UI: Trả về cấu hình
    deactivate AppState
end

autonumber 2.1
group 2. Tính điểm ưu tiên và sắp xếp
    UI -> Scheduler: Gửi danh sách xe và dữ liệu sạc
    activate Scheduler

    alt Dữ liệu không hợp lệ
        Scheduler --> UI: Báo lỗi dữ liệu đầu vào
        UI --> Operator: Hiển thị thông báo lỗi
    else Dữ liệu hợp lệ
        Scheduler -> Scheduler: Tính Priority Score\n(SoC, HasBooking, độ khẩn cấp, giờ điện)
        Scheduler -> Scheduler: Sắp xếp hàng chờ giảm dần\ntheo Priority Score
        Scheduler --> UI: Trả về thứ tự ưu tiên
    end
    deactivate Scheduler
end

autonumber 3.1
group 3. Phân bổ công suất và lập lịch
    UI -> Scheduler: Yêu cầu lập lịch sạc
    activate Scheduler

    Scheduler -> Scheduler: Kiểm tra Peak Power Capping

    alt Vượt giới hạn công suất
        Scheduler -> Scheduler: Điều chỉnh công suất\nhoặc thời điểm sạc
        alt Vẫn vượt giới hạn
            Scheduler --> UI: Chưa thể phân bổ cổng sạc
            UI --> Operator: Thông báo giới hạn công suất
        else Công suất hợp lệ
            Scheduler --> UI: Trả về lịch sạc đã điều chỉnh
        end
    else Không vượt giới hạn
        Scheduler --> UI: Trả về lịch sạc hợp lệ
    end
    deactivate Scheduler

    UI -> AppState: Cập nhật xe và cổng sạc\ntheo lịch đã lập
    activate AppState
    AppState --> UI: Xác nhận cập nhật
    deactivate AppState

    UI --> Operator: Hiển thị thứ tự ưu tiên\nvà lịch sạc
    deactivate UI
end

@enduml

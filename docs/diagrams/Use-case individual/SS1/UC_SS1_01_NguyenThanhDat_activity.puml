@startuml UC_SS1_01_NguyenThanhDat_activity
!theme plain
skinparam activityMessageAlign center

title Activity Diagram - UC_SS1_01: Đặt giữ chỗ & Quét QR/PIN nhận xe

|Sinh viên ĐHQG-HCM|
start
:Chọn Hub & Xe cần thuê;

|UI Layer (student_booking.py)|
:Kiểm tra xác thực VNU-SSO;

|Control & State (st.session_state)|
:Đọc danh sách xe\n(AVAILABLE, SoC > 20%);

|UI Layer (student_booking.py)|
if (Số dư ví >= 50,000 VNĐ?) then (Không đủ)
  :Báo lỗi "Số dư không đủ"\n& chuyển hướng sang Nạp tiền;
  stop
else (Đủ)
  |Tài khoản & Ví điện tử|
  :Khóa 50,000 VNĐ cọc\nvào locked_balance;
  
  |Control & State (st.session_state)|
  :Đổi xe sang RESERVED\n& Kích hoạt Timer 15p;
  
  |UI Layer (student_booking.py)|
  :Xuất mã QR/PIN & đếm ngược;
endif

|Sinh viên ĐHQG-HCM|
:Đến Hub quét QR/PIN\nnhận xe;

|UI Layer (student_booking.py)|
:Đối chiếu mã & đếm ngược;
if (Thời gian giữ chỗ?) then (Quá 15p - No-show)
  |Tài khoản & Ví điện tử|
  :Phạt 10,000 VNĐ, hoàn 40,000 VNĐ\nvề wallet_balance;
  
  |Control & State (st.session_state)|
  :Đổi xe = AVAILABLE;
  
  |UI Layer (student_booking.py)|
  :Báo hết hạn;
  stop
else (Hợp lệ <= 15p)
  |UI Layer (student_booking.py)|
  :Gửi lệnh mở khóa sang Khóa IoT;
  
  |Khóa thông minh IoT / Trạm Hub|
  :Mở chốt an toàn;
  
  fork
    |Control & State (st.session_state)|
    :Đổi xe = IN_USE &\nKích hoạt đếm giờ chuyến đi;
  fork again
    |UI Layer (student_booking.py)|
    :Hiển thị màn hình\n'Đang di chuyển';
  end fork
  
  stop
endif

@enduml
